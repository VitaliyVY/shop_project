#!/usr/bin/env python3
"""Print the ticket context used by the SessionStart hook."""

from pathlib import Path


def main() -> int:
    ticket_file = Path(__file__).resolve().parents[1] / "ticket.md"
    print(ticket_file.read_text(encoding="utf-8"), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())