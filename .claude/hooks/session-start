#!/usr/bin/env python3
"""Print the project context used by the SessionStart hook."""

from pathlib import Path


def main() -> int:
    project_file = Path(__file__).resolve().parents[1] / "project.md"
    print(project_file.read_text(encoding="utf-8"), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())